<style id="stylableCss_axdf2">/* END STYLABLE DIRECTIVE RULES */

#comp-mceyhtb8 .style-mms55npa__root{
    -st-extends: StylableButton;
    transition: all 0.2s ease, visibility 0s;
    background: rgba(0, 0, 0, 0);
    padding: 4px;
    border-bottom: 0px solid rgb(232, 228, 217)
}

/* START STYLABLE DIRECTIVE RULES */

#comp-mceyhtb8 .style-mms55npa__root:hover {
    border-bottom: 2px solid rgb(12, 68, 38);
}

#comp-mceyhtb8 .style-mms55npa__root:disabled{
    background: rgba(226, 226, 226, 0)
}

#comp-mceyhtb8 .style-mms55npa__root:disabled .StylableButton2545352419__label{
    color: #8F8F8F
}

#comp-mceyhtb8 .style-mms55npa__root:disabled .StylableButton2545352419__icon{
    fill: #8F8F8F
}

#comp-mceyhtb8 .style-mms55npa__root .StylableButton2545352419__container{
    transition: inherit
}

#comp-mceyhtb8 .style-mms55npa__root .StylableButton2545352419__label{
    transition: inherit;
    font-style: normal;
    font-weight: 700;
    text-decoration-line: none;
    color: #E8E4D9;
    font-family: avenir-lt-w01_35-light1475496,sans-serif;
    font-size: 15px;
    letter-spacing: 0.05em
}

#comp-mceyhtb8 .style-mms55npa__root .StylableButton2545352419__icon{
    transition: inherit;
    width: 10px;
    height: 10px;
    fill: #FFFFFF;
    display: none
}

@media screen and (min-width: 1px) and (max-width: 0px) {
    #comp-mceyhtb8 .style-mms55npa__root .StylableButton2545352419__label {
        color: #7F6F40;
        font-size: 10px;
    }
    #comp-mceyhtb8 .style-mms55npa__root {
        border-bottom: 1px solid #7F6F40;
    }
}</style>
